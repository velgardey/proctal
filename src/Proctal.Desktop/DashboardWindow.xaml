<Window x:Class="Proctal.Desktop.DashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Proctal.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Proctal · Setup" Width="1100" Height="800" MinWidth="850" MinHeight="560" Background="Transparent" WindowStyle="None" WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="7" GlassFrameThickness="-1" CornerRadius="14" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#DC1B1D21"/><SolidColorBrush x:Key="PanelBrush" Color="#B5282B31"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F1F2F4"/><SolidColorBrush x:Key="MutedBrush" Color="#B9BDC6"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#554F545F"/><SolidColorBrush x:Key="FieldBrush" Color="#E0191C21"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#B5363A42"/><SolidColorBrush x:Key="AccentBrush" Color="#ECEEF1"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1C1F24"/><SolidColorBrush x:Key="StatusBrush" Color="#B9D8C0"/><SolidColorBrush x:Key="SelectionBrush" Color="#4C5869"/>
    <Style x:Key="HelpText" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/></Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}"><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></Style.Triggers></Style>
    <Style x:Key="Disclosure" TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,18,0,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
      <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" VerticalAlignment="Center"/><Path x:Name="Chevron" Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Right" RenderTransformOrigin=".5,.5"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource TextBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
      <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,4,0,8"/>
    </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="WorkspaceTab" TargetType="TabItem" BasedOn="{StaticResource ControlBase}"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=TabItem}}"/></DataTemplate></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#303F444E"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#75434851"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="WorkspaceTabs" TargetType="TabControl"><Setter Property="TabStripPlacement" Value="Left"/><Setter Property="ItemContainerStyle" Value="{StaticResource WorkspaceTab}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#98131519" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,26,16,22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="12,0,0,28"><TextBlock Text="Proctal" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Your practice workspace" Style="{StaticResource HelpText}" FontSize="11" Margin="0,6,0,0"/></StackPanel><TabPanel Grid.Row="1" IsItemsHost="True" VerticalAlignment="Top"/>
        <StackPanel Grid.Row="2" Margin="12,0,0,0"><TextBlock Text="In the overlay" Style="{StaticResource HelpText}" Margin="0,0,0,14"/><TextBlock Text="F8    Speech on / off" FontFamily="{StaticResource CodeFont}" FontSize="11" Margin="0,0,0,10"/><TextBlock Text="F11   Answer speech" FontFamily="{StaticResource CodeFont}" FontSize="11" Margin="0,0,0,10"/><TextBlock Text="F12   Show / hide" FontFamily="{StaticResource CodeFont}" FontSize="11"/><TextBlock Text="More in Appearance" Style="{StaticResource HelpText}" FontSize="11" Margin="0,16,0,0"/></StackPanel>
      </Grid></Border><Border Grid.Column="1" Padding="28,26,28,12"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border>
    </Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SettingsTabs" TargetType="TabControl"><Setter Property="ItemContainerStyle" Value="{StaticResource WorkspaceTab}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True" Margin="0,0,0,18"/><ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Margin="1">
  <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,0,6,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Proctal / Setup" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="−" Click="MinimizeWindow" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Minimize workspace"/><Button Content="□" Click="MaximizeWindow" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Maximize or restore workspace"/><Button Content="×" Click="HideWorkspace" Style="{StaticResource CaptionButton}" AutomationProperties.Name="Hide workspace"/></StackPanel>
    </Grid></Border>
    <TabControl x:Name="Workspace" Grid.Row="1" Style="{StaticResource WorkspaceTabs}">
            <TabItem Header="Start"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,12">
        <TextBlock Text="Set up your next practice." Style="{StaticResource PageTitle}"/><TextBlock Text="Connect your models, add context, then launch the overlay." Style="{StaticResource HelpText}" Margin="0,0,0,20"/>
        <WrapPanel Margin="0,0,0,20"><Button Content="Configure models" Click="GoConnection"/><Button Content="Add resume &amp; notes" Click="GoContext"/><Button Content="Answer mode &amp; prompt" Click="GoAnswers" Style="{StaticResource QuietButton}"/></WrapPanel>        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,16"><StackPanel>
          <TextBlock Text="Interview audio" Style="{StaticResource SectionTitle}"/><TextBlock Text="Choose the speaker output playing the interview." FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
          <Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Interviewer · speaker output" Style="{StaticResource Label}"/><ComboBox AutomationProperties.Name="Interview audio output" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}" IsEnabled="{Binding CanEditAudio}" DisplayMemberPath="Name"/><ProgressBar Value="{Binding OutputLevel, Mode=OneWay}" Maximum="100" Height="3" Foreground="#A6D9B1" Background="#334E6078"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Your microphone · optional" Style="{StaticResource Label}"/><ComboBox AutomationProperties.Name="Your microphone" ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}" IsEnabled="{Binding CanEditAudio}" DisplayMemberPath="Name"/><ProgressBar Value="{Binding InputLevel, Mode=OneWay}" Maximum="100" Height="3" Foreground="#A6D9B1" Background="#334E6078"/></StackPanel>
          </Grid>
          <TextBlock Text="Transcription language · e.g. en" Style="{StaticResource Label}"/><TextBox AutomationProperties.Name="Transcription language" Text="{Binding Settings.Language, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditAudio}" MaxLength="12"/><WrapPanel Margin="0,12,0,4"><CheckBox Content="Include my microphone" IsChecked="{Binding Settings.IncludeMicrophone}" IsEnabled="{Binding CanEditAudio}" Margin="0,5,22,10"/><CheckBox Content="Answer questions automatically" IsChecked="{Binding Settings.AutoAnswer}"/></WrapPanel>
          <WrapPanel><Button Content="{Binding ListenButtonText}" IsEnabled="{Binding CanToggleListen}" Click="ToggleListening" Style="{StaticResource QuietButton}"/><Button IsEnabled="{Binding CanEditAudio}" Content="Refresh devices" Click="RefreshDevices" Style="{StaticResource QuietButton}"/></WrapPanel>
        </StackPanel></Border>        <CheckBox Content="Open the overlay directly next time" IsChecked="{Binding Settings.LaunchOverlayOnStartup}" Margin="0,8,0,0"/>
        <Expander Header="Target role &amp; job description" Style="{StaticResource Disclosure}"><StackPanel>            <TextBlock Text="Target role / company" Style="{StaticResource Label}"/><TextBox AutomationProperties.Name="Target role and company" Text="{Binding Settings.Role, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Job description" Style="{StaticResource Label}"/><TextBox AutomationProperties.Name="Job description" Text="{Binding Settings.JobDescription, UpdateSourceTrigger=PropertyChanged}" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel></Expander>
        <Expander Header="Mock interview" Style="{StaticResource Disclosure}"><StackPanel><TextBlock Text="Ask a practice question, then type your response here for feedback." Style="{StaticResource HelpText}" Margin="0,0,0,12"/><TextBox AutomationProperties.Name="Your mock interview answer" Text="{Binding ManualText, UpdateSourceTrigger=PropertyChanged}" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><WrapPanel Margin="0,12,0,0"><Button Content="Practice question" Click="PracticeQuestion"/><Button Content="Review my answer" Click="GradeAnswer"/></WrapPanel></StackPanel></Expander>
      </StackPanel></ScrollViewer></TabItem><TabItem Header="Context"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Résumé and context" FontSize="20" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="PDF, DOCX, TXT or Markdown. Check the extracted text before using it." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,12"/><Button Grid.Row="2" Content="Import documents" Click="ImportDocuments"/><ListBox AutomationProperties.Name="Imported documents" Grid.Row="3" x:Name="DocumentList" ItemsSource="{Binding Documents}" DisplayMemberPath="Name" SelectionChanged="SelectDocument"/><Button Grid.Row="4" Content="Remove selected" Click="RemoveDocument" Margin="0,12,0,8"/></Grid>
        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Review or paste context" FontSize="20" FontWeight="SemiBold"/><TextBox AutomationProperties.Name="Context document name" x:Name="DocumentName" Grid.Row="1" Margin="0,14,0,12" Text="Pasted notes"/><Grid Grid.Row="2"><TextBox AutomationProperties.Name="Context document text" x:Name="DocumentText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock Text="Paste résumé text or notes here. You can edit imported text before saving it." Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" Margin="12,10"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=DocumentText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><WrapPanel Grid.Row="3" Margin="0,12,0,0"><Button Content="Save selected document" Click="SaveDocument"/><Button Content="Add as new notes" Click="AddNotes"/></WrapPanel></Grid>
      </Grid></TabItem>
      <TabItem Header="Setup"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Configure your workspace." Style="{StaticResource PageTitle}"/><TextBlock Grid.Row="1" Text="Connect and test your models, then save and launch." Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,0,0,22"/>
        <TabControl x:Name="SettingsPages" Grid.Row="2" Style="{StaticResource SettingsTabs}">
                    <TabItem Header="Connection"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,12">
            <Border Style="{StaticResource GlassPanel}"><StackPanel><TextBlock Text="Connect Azure" Style="{StaticResource SectionTitle}"/><TextBlock Text="Use the resource where Luna and live transcription are deployed." Style="{StaticResource HelpText}"/>
              <StackPanel x:Name="ConnectionFields"><TextBlock Text="Resource endpoint" Style="{StaticResource Label}"/><TextBox AutomationProperties.Name="Azure resource endpoint" Text="{Binding Settings.Endpoint, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Paste the resource URL or its /openai/v1/ endpoint." Style="{StaticResource HelpText}" FontSize="12" Margin="0,7,0,0"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Answer deployment" Style="{StaticResource Label}"/><TextBox AutomationProperties.Name="Answer deployment" Text="{Binding Settings.AnswerDeployment, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Transcription deployment" Style="{StaticResource Label}"/><TextBox AutomationProperties.Name="Live transcription deployment" Text="{Binding Settings.TranscriptionDeployment, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
                <TextBlock Text="Sol deployment · F6, optional" Style="{StaticResource Label}"/><TextBox AutomationProperties.Name="Sol deployment" Text="{Binding Settings.SolDeployment, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Uses the same resource and key. F6 requests Sol with high reasoning; F11 keeps Luna." Style="{StaticResource HelpText}" FontSize="12" Margin="0,7,0,0"/>
                <TextBlock Text="Azure API key" Style="{StaticResource Label}"/><PasswordBox x:Name="ApiKey" AutomationProperties.Name="Azure key"/><TextBlock Text="Leave blank to keep your saved key. Protected for your Windows account." Style="{StaticResource HelpText}" FontSize="12" Margin="0,7,0,0"/>
              </StackPanel>
              <WrapPanel Margin="0,22,0,0"><Button x:Name="TestConnectionControl" Content="Test connection" Click="CheckConnection" Margin="0,0,12,0"/><Button x:Name="TestSolConnectionControl" Content="Test Sol" Click="CheckConnection" Style="{StaticResource QuietButton}"/></WrapPanel><TextBlock Text="Test connection checks Luna and transcription. Test Sol checks the optional F6 model. No microphone audio is sent." Style="{StaticResource HelpText}" FontSize="12" Margin="0,10,0,0"/>
            </StackPanel></Border>
            <TextBlock Text="Audio and selected context go to your Azure resource. Images are sent when you choose an image answer." Style="{StaticResource HelpText}" Margin="0,16,0,0"/>
            <Expander x:Name="KeyOptions" Header="Manage stored key" Style="{StaticResource Disclosure}"><StackPanel><TextBlock Text="Removing the saved key requires you to enter it again. An environment key, if configured, can still be used." Style="{StaticResource HelpText}" Margin="0,0,0,12"/><Button x:Name="RemoveKeyControl" Content="Remove stored key" Click="RemoveKey" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/></StackPanel></Expander>
          </StackPanel></ScrollViewer></TabItem><TabItem Header="Answers"><ScrollViewer x:Name="AnswerSettingsScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Answer mode" Style="{StaticResource Label}"/><ComboBox x:Name="AnswerModePicker" AutomationProperties.Name="Answer mode" SelectedValue="{Binding Settings.Mode}" SelectedValuePath="Content"><ComboBoxItem Content="General"/><ComboBoxItem Content="Behavioral"/><ComboBoxItem Content="Technical"/></ComboBox></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Response structure" Style="{StaticResource Label}"/><ComboBox x:Name="ResponseStructurePicker" AutomationProperties.Name="Coding response structure" SelectedValue="{Binding Settings.ResponseStructure}" SelectedValuePath="Content"><ComboBoxItem Content="Code first"/><ComboBoxItem Content="Insight → solution"/><ComboBoxItem Content="Problem → brute force → optimize"/></ComboBox></StackPanel>
            </Grid>
            <TextBlock Text="Insight walks through code and examples. Teaching builds from brute force." Style="{StaticResource HelpText}" Margin="0,8,0,0" FontSize="12"/>
            <TextBlock Text="Initial prompt · optional" Style="{StaticResource Label}" Margin="0,10,0,6"/>
            <TextBox x:Name="AnswerInstructionsEditor" AutomationProperties.Name="Initial prompt" Text="{Binding Settings.Instructions, UpdateSourceTrigger=PropertyChanged}" Height="100" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="Your custom response instructions take priority over the preset. Leave blank to use it. Save changes to keep your prompt." Style="{StaticResource HelpText}" Margin="0,8,0,6" FontSize="12"/>
            <TextBlock Text="No app output-token cap. Azure's model limits still apply; longer answers use more time and tokens." Style="{StaticResource HelpText}" FontSize="12"/>
            <Expander x:Name="AnswerOptions" Header="Model options" Style="{StaticResource Disclosure}"><StackPanel>            <CheckBox Content="Request Fast processing when Azure supports it" IsChecked="{Binding Settings.FastProcessing}" Margin="0,12,0,10"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Reasoning · none is fastest" Style="{StaticResource Label}"/><ComboBox AutomationProperties.Name="Luna reasoning" SelectedValue="{Binding Settings.ReasoningEffort}" SelectedValuePath="Content"><ComboBoxItem Content="none"/><ComboBoxItem Content="low"/></ComboBox></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Default coding language" Style="{StaticResource Label}"/><TextBox AutomationProperties.Name="Default coding language" Text="{Binding Settings.CodingLanguage, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"/></StackPanel>
            </Grid>
            <TextBlock Text="The question's language takes priority. Longer output takes longer to finish." FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,8"/><TextBlock Text="F7 requests xhigh reasoning without changing your default." Style="{StaticResource HelpText}"/></StackPanel></Expander>

          </StackPanel></ScrollViewer></TabItem>
          <TabItem Header="Appearance"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,12">
            <TextBlock Text="A comfortable reading space" Style="{StaticResource SectionTitle}"/><TextBlock Text="Appearance changes save automatically and apply to the overlay." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,16"/>
            <WrapPanel><Button Content="Compact" Click="CompactPreset"/><Button Content="Standard" Click="StandardPreset"/><Button Content="Reading" Click="ReadingPreset"/></WrapPanel>
            <Border Style="{StaticResource GlassPanel}" Margin="0,12,0,18"><StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Window opacity"/><TextBlock Grid.Column="1" Text="{Binding Overlay.Opacity, StringFormat={}{0:P0}}" Foreground="{DynamicResource AccentBrush}" FontFamily="{StaticResource CodeFont}" FontSize="12"/></Grid>
              <Slider AutomationProperties.Name="Window opacity" Minimum="0.35" Maximum="1" Value="{Binding Overlay.Opacity}" Margin="0,12,0,6"/>
              <TextBlock Text="Ctrl+Alt+[ / ] · fades the entire overlay, including text" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
              <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Answer text size"/><TextBlock Grid.Column="1" Text="{Binding Overlay.FontSize, StringFormat={}{0:0} px}" Foreground="{DynamicResource AccentBrush}" FontFamily="{StaticResource CodeFont}" FontSize="12"/></Grid>
              <Slider AutomationProperties.Name="Answer text size" Minimum="12" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Overlay.FontSize}" Margin="0,12,0,6"/>
              <TextBlock Text="Ctrl+Alt+− / +" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel></Border>
            <WrapPanel><CheckBox Content="Glass surface" IsChecked="{Binding Overlay.Glass}" Margin="0,5,24,10"/><CheckBox Content="Wrap code" IsChecked="{Binding Overlay.CodeWrap}" Margin="0,5,24,10"/><CheckBox Content="Compact controls" IsChecked="{Binding Overlay.Compact}"/></WrapPanel>
            <WrapPanel><CheckBox Content="Follow streaming text" IsChecked="{Binding Overlay.AutoFollow}" Margin="0,5,24,10"/><CheckBox Content="Always on top" IsChecked="{Binding Overlay.AlwaysOnTop}"/></WrapPanel>
            <CheckBox Content="Show live captions" IsChecked="{Binding Overlay.ShowCaptions}"/><TextBlock Text="Caption height" Style="{StaticResource Label}"/><Slider AutomationProperties.Name="Caption height" Minimum="60" Maximum="180" Value="{Binding Overlay.CaptionHeight, UpdateSourceTrigger=PropertyChanged}"/><Expander x:Name="SharingOptions" Header="Screen sharing" Style="{StaticResource Disclosure}"><StackPanel>            <CheckBox Content="Exclude windows from supported screen capture" IsChecked="{Binding Settings.CaptureExclusion}" Margin="0,12,0,10"/>
            <TextBlock Text="{Binding Privacy}" FontSize="12" Foreground="{DynamicResource StatusBrush}"/>
            <TextBlock Text="Windows capture exclusion cannot guarantee invisibility. Check the receiver's view in your sharing app. History stays in memory unless local saving is enabled." FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,12"/>
</StackPanel></Expander><Expander x:Name="ShortcutOptions" Header="Keyboard shortcuts" Style="{StaticResource Disclosure}"><StackPanel>
            <TextBlock Text="Ctrl+Alt+↑↓ to scroll; PageUp / PageDown to page; Home / End for top / bottom. Add Shift to Ctrl+Alt+arrows to resize. Ctrl+Shift+arrows moves the overlay. Ctrl+Alt+0 resets its layout." Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,8,0,14"/>
            <TextBlock Text="F6 Sol; F7 deep Luna; F8 speech; F9 images; F10 capture; F11 answer speech; double F11 images; F12 show/hide. Ctrl+Alt+Q types a question, C copies code, H opens history. Ctrl+Alt+1 / 2 / 3 explains, checks edge cases, or optimizes; M switches compact mode." Foreground="{DynamicResource MutedBrush}" FontSize="13"/></StackPanel></Expander>
          </StackPanel></ScrollViewer></TabItem>
        </TabControl>
      </Grid></TabItem>
      <TabItem Header="History"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Review past questions." Style="{StaticResource PageTitle}"/><CheckBox Content="Save answer history locally for future sessions" IsChecked="{Binding Settings.SaveHistory}" Margin="0,4,0,20"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBox x:Name="HistorySearch" AutomationProperties.Name="Search answer history" Text="{Binding HistoryQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search questions and answers" Margin="0,0,0,10"/><TextBlock Text="Search questions and answers" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" Margin="12,10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=HistorySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ListBox Grid.Row="1" AutomationProperties.Name="Answer history" x:Name="HistoryList" ItemsSource="{Binding VisibleHistory}" SelectionChanged="SelectHistory" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontSize="13"/><TextBlock Text="{Binding At, StringFormat={}{0:MMM d · HH:mm}}" Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource CodeFont}" FontSize="10" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid><Button Grid.Row="1" Content="Delete selected entry" Click="DeleteHistory" Margin="0,12,0,0"/></Grid><Grid Grid.Column="2"><local:MarkdownView AutomationProperties.Name="Selected history answer" x:Name="HistoryText" IsDark="True" AutoFollow="False"/><TextBlock Text="Select an answer to review it here. Enable local saving above and choose Save changes to retain future questions." Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" Margin="12,10"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=HistoryText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid></Grid></TabItem>
