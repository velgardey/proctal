<Window x:Class="Proctal.Desktop.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Proctal.Desktop" Title="Proctal · Practice overlay" Width="620" Height="620" MinWidth="480" MinHeight="430" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResize">
  <Window.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#CC202124"/><SolidColorBrush x:Key="PanelBrush" Color="#DC202124"/><SolidColorBrush x:Key="TextBrush" Color="#F1F2F4"/><SolidColorBrush x:Key="MutedBrush" Color="#AEB0B6"/><SolidColorBrush x:Key="BorderBrush" Color="#32FFFFFF"/><SolidColorBrush x:Key="FieldBrush" Color="#5017191D"/><SolidColorBrush x:Key="ButtonBrush" Color="#302F3137"/><SolidColorBrush x:Key="SelectionBrush" Color="#60545A65"/><SolidColorBrush x:Key="AccentBrush" Color="#ECEDEF"/><SolidColorBrush x:Key="AccentTextBrush" Color="#202124"/>
    <SolidColorBrush x:Key="OverlayHoverBrush" Color="#505F626A"/>
    <Style x:Key="OverlayButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="30"/><Setter Property="Background" Value="{DynamicResource ButtonBrush}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"/></DataTemplate></Setter.Value></Setter><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource OverlayHoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value=".65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource OverlayButton}"><Setter Property="Padding" Value="9,6"/><Setter Property="Height" Value="30"/></Style>
    <Style x:Key="GlassSurface" TargetType="Border"><Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/><Setter Property="BorderBrush"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#55FFFFFF" Offset="0"/><GradientStop Color="#20FFFFFF" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
    <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource OverlayButton}"><Setter Property="Margin" Value="0,0,6,6"/></Style>
  </Window.Resources>
  <Border x:Name="GlassShell" Background="Transparent" Margin="8">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border x:Name="PrimaryToolbar" Style="{StaticResource GlassSurface}" Background="{DynamicResource PanelBrush}" Height="44" Padding="6" MouseLeftButtonDown="DragHeader" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="ListenControl" IsEnabled="{Binding CanToggleListen}" Click="ToggleListening" ToolTip="{Binding ListenButtonText}" Margin="0,0,5,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}"><Setter Property="Content" Value="Listen"/><Style.Triggers><DataTrigger Binding="{Binding IsListening}" Value="True"><Setter Property="Content" Value="Pause"/><Setter Property="Foreground" Value="#A4D9AC"/></DataTrigger><DataTrigger Binding="{Binding IsStarting}" Value="True"><Setter Property="Content" Value="Cancel"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        <Button x:Name="TextAnswerControl" Grid.Column="1" Click="GetAnswer" Margin="0,0,5,0"><Button.Resources><SolidColorBrush x:Key="OverlayHoverBrush" Color="#F8F9FA"/></Button.Resources><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}"><Setter Property="Content" Value="Answer · F11"/><Setter Property="Background" Value="#E8ECEDEF"/><Setter Property="Foreground" Value="#202124"/><Setter Property="IsEnabled" Value="{Binding CanSubmitText}"/><Setter Property="ToolTip" Value="Answer speech or typed text immediately"/><Style.Triggers><DataTrigger Binding="{Binding IsAnswering}" Value="True"><Setter Property="Content" Value="Stop"/><Setter Property="IsEnabled" Value="True"/><Setter Property="ToolTip" Value="Stop this answer · Ctrl+Alt+Escape"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
        <Button Grid.Column="2" Content="Capture · F10" Click="CaptureImage" Style="{StaticResource ToolbarButton}" Margin="0,0,5,0" ToolTip="Attach a screenshot. F9 or double F11 answers images."/>
        <Button Grid.Column="3" Content="Chat" Click="EditQuestion" Style="{StaticResource ToolbarButton}" ToolTip="Type a question · Ctrl+Alt+Q"/>
        <Button Grid.Column="5" x:Name="MoreControl" Content="···" Click="ToggleTune" Style="{StaticResource ToolbarButton}" FontSize="18" Padding="9,0" Margin="4,0,5,0" AutomationProperties.Name="More controls" ToolTip="More · Ctrl+Alt+V"/>
        <Button Grid.Column="6" Content="Hide" Click="HideOverlay" Style="{StaticResource ToolbarButton}" ToolTip="Hide overlay · F12"/>
      </Grid></Border>
      <Border x:Name="CaptionPanel" Grid.Row="1" Style="{StaticResource GlassSurface}" Background="{DynamicResource PanelBrush}" Padding="10,6" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,10,0"><Ellipse Width="5" Height="5"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#70747E"/><Style.Triggers><DataTrigger Binding="{Binding IsListening}" Value="True"><Setter Property="Fill" Value="#9DD5A4"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding AudioStatus}" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><Grid Grid.Column="1"><local:LiveCaptionView x:Name="CaptionContent" Height="30" Text="{Binding Transcript}" AutomationProperties.Name="Streaming interview captions"/><TextBlock Text="Interviewer speech appears here" Foreground="{DynamicResource MutedBrush}" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Transcript}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button Grid.Column="2" x:Name="CaptionExpandControl" Content="⌄" Click="ExpandCaptions" Style="{StaticResource ToolbarButton}" FontSize="16" Margin="6,0,0,0" Padding="7,2" AutomationProperties.Name="Expand or collapse captions" ToolTip="Expand captions to read the conversation"/></Grid></Border>
      <Border x:Name="TunePanel" Grid.Row="3" Panel.ZIndex="10" VerticalAlignment="Top" HorizontalAlignment="Right" Width="360" Visibility="Collapsed" Style="{StaticResource GlassSurface}" Background="{DynamicResource PanelBrush}" Padding="12" Margin="0,0,0,8"><ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Focusable="False"><StackPanel>
        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Quick controls" FontSize="12" FontWeight="SemiBold"/><Button Grid.Column="1" Content="Setup" Click="OpenSetup" Style="{StaticResource MenuButton}" ToolTip="Connection, context and detailed preferences"/></Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="Opacity" FontSize="12" VerticalAlignment="Center"/><Slider x:Name="OpacityControl" Grid.Column="1" Minimum="0.35" Maximum="1" Value="{Binding Overlay.Opacity, UpdateSourceTrigger=PropertyChanged}" Focusable="False" Margin="12,0" AutomationProperties.Name="Window opacity"/><TextBlock Grid.Column="2" Text="{Binding Overlay.Opacity, StringFormat={}{0:P0}}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/></Grid>
        <WrapPanel Margin="0,10,0,0"><Button Content="A−" Click="ZoomOut" Style="{StaticResource MenuButton}"/><Button Content="A+" Click="ZoomIn" Style="{StaticResource MenuButton}"/><CheckBox Content="Compact" IsChecked="{Binding Overlay.Compact}" Margin="6,5,14,8"/><CheckBox Content="Captions" IsChecked="{Binding Overlay.ShowCaptions}" Margin="0,5,0,8"/></WrapPanel>
        <WrapPanel><CheckBox x:Name="AutoAnswerControl" Content="Auto answer" IsChecked="{Binding Settings.AutoAnswer}" Margin="0,4,16,10"/><CheckBox x:Name="MicrophoneControl" Content="My microphone" IsChecked="{Binding Settings.IncludeMicrophone}" IsEnabled="{Binding CanEditAudio}" Margin="0,4,16,10"/><CheckBox Content="Pin answer" IsChecked="{Binding Pinned}" Margin="0,4,0,10"/></WrapPanel>
        <Border Height="1" Background="#25FFFFFF" Margin="0,2,0,12"/>
        <WrapPanel><Button Content="Sol answer · F6" Click="SolAnswer" IsEnabled="{Binding CanSubmitDeep}" Style="{StaticResource MenuButton}"/><Button x:Name="DeepAnswerControl" Content="Deep answer · F7" Click="DeepAnswer" IsEnabled="{Binding CanSubmitDeep}" Style="{StaticResource MenuButton}" ToolTip="One answer with Luna xhigh reasoning; may take longer. Uses attached images, fresh text, or the displayed question."/><Button x:Name="HistoryControl" Content="History" Click="OpenHistory" Style="{StaticResource MenuButton}" ToolTip="Search saved questions and answers · Ctrl+Alt+H (opens Setup)"/></WrapPanel>
        <WrapPanel x:Name="FollowupActions"><Button Content="Explain" Click="Explain" IsEnabled="{Binding CanFollowUp}" Style="{StaticResource MenuButton}" ToolTip="Ctrl+Alt+1"/><Button Content="Edge cases" Click="Edges" IsEnabled="{Binding CanFollowUp}" Style="{StaticResource MenuButton}" ToolTip="Ctrl+Alt+2"/><Button Content="Optimize" Click="Optimize" IsEnabled="{Binding CanFollowUp}" Style="{StaticResource MenuButton}" ToolTip="Ctrl+Alt+3"/></WrapPanel>
        <WrapPanel><Button Content="Previous" Click="PreviousAnswer" Style="{StaticResource MenuButton}"/><Button Content="Next" Click="NextAnswer" Style="{StaticResource MenuButton}"/><Button Content="Latest" Click="ShowLatest" Style="{StaticResource MenuButton}"/><Button Content="Copy code" Click="CopyCode" Style="{StaticResource MenuButton}"/><Button Content="Export" Click="ExportAnswer" Style="{StaticResource MenuButton}"/></WrapPanel>
        <WrapPanel><Button Content="Attach images" Click="AttachImage" Style="{StaticResource MenuButton}"/><Button Content="Practice" Click="PracticeQuestion" Style="{StaticResource MenuButton}"/><Button Content="Review" Click="ReviewAnswer" Style="{StaticResource MenuButton}"/><Button Content="Mouse controls" Click="ToggleMouse" Style="{StaticResource MenuButton}" ToolTip="Ctrl+Shift+I"/></WrapPanel>
        <TextBlock Text="F12 hide · Ctrl+Alt+↑↓ scroll · Ctrl+Alt+Q type" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/>
      </StackPanel></ScrollViewer></Border>
      <Border x:Name="AnswerSurface" Grid.Row="3" Style="{StaticResource GlassSurface}" Padding="14,12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ScrollViewer x:Name="QuestionScroller" MaxHeight="52" VerticalScrollBarVisibility="Auto" Focusable="False"><TextBlock Text="{Binding DisplayQuestion}" FontSize="14" FontWeight="Medium"/></ScrollViewer><Button Grid.Column="1" Content="Latest" Click="ShowLatest" Margin="10,0,0,0" ToolTip="Return to live answer · Ctrl+Alt+L"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource OverlayButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBrowsingHistory}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid></Border>
        <local:MarkdownView x:Name="AnswerContent" Grid.Row="1" Text="{Binding DisplayAnswer}" FontSize="{Binding Overlay.FontSize}" CodeWrap="{Binding Overlay.CodeWrap}" AutoFollow="{Binding Overlay.AutoFollow}" AutomationProperties.Name="Formatted Luna answer"/>
        <StackPanel x:Name="Composer" Grid.Row="2" Visibility="Collapsed" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ScrollViewer MaxHeight="76" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.Name="Attached image previews"><ItemsControl ItemsSource="{Binding Screenshots}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#302F3137" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,5,0"><StackPanel Orientation="Horizontal"><Image Source="{Binding Preview}" Width="40" Height="28" Stretch="Uniform"/><Button Content="×" Tag="{Binding}" Click="RemoveImage" Style="{StaticResource OverlayButton}" Padding="4,2" AutomationProperties.Name="Remove attached image"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ImageAnswerControl" Content="Images · F9" Click="AnswerImages" IsEnabled="{Binding CanAnswerImages}" Style="{StaticResource OverlayButton}" ToolTip="Answer attached images · F9 / double F11 / Ctrl+Alt+S"/><Button Content="×" Click="ClearImages" Style="{StaticResource OverlayButton}" Padding="7,2" Margin="5,0,0,0" AutomationProperties.Name="Clear images" ToolTip="Clear images · Ctrl+Alt+Backspace"/></StackPanel></Grid></StackPanel>
        <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="OperationStatus" Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextWrapping="Wrap" ToolTip="{Binding Status}" AutomationProperties.Name="Operation status"/><TextBlock x:Name="ReadingState" Grid.Column="1" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Bottom" ToolTip="Ctrl+Alt+End follows the latest answer"/><TextBlock Grid.Column="2" Text="{Binding Latency}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Bottom" ToolTip="{Binding Tier}"/></Grid>
      </Grid></Border>
    </Grid>
  </Border>
</Window>
