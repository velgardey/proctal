<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Proctal</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Proctal.Core/Proctal.Core.csproj"/></ItemGroup>
  <ItemGroup><PackageReference Include="Markdig" Version="1.6.0"/><PackageReference Include="WpfMath" Version="2.1.0"/></ItemGroup>
  <ItemGroup><Content Include="Assets/Licenses/*" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
  <ItemGroup><Resource Include="Assets/Fonts/*.ttf"/><Content Include="Assets/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
</Project>
