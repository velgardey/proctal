<Window x:Class="Proctal.Desktop.QuestionEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Proctal · Edit question" Width="580" Height="300" MinWidth="400" MinHeight="240" Background="{DynamicResource BackgroundBrush}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Question or practice response" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
    <TextBox x:Name="Editor" Grid.Row="1" AutomationProperties.Name="Question or practice response" Text="{Binding ManualText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    <WrapPanel Grid.Row="2" Margin="0,14,0,0"><Button Content="Answer · F11" Click="Submit" Style="{StaticResource PrimaryButton}"/><Button Content="Review my response" Click="Review"/><Button Content="Close · Esc" Click="CloseEditor" Style="{StaticResource QuietButton}"/></WrapPanel>
  </Grid>
</Window>
